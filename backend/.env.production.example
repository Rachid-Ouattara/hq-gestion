# Gabarit pour l'environnement de PRODUCTION (gestion.headquaters.org).
# Copier vers backend/.env sur le VPS et remplir les valeurs — ce fichier n'est
# jamais commité avec de vraies valeurs (voir .gitignore : .env est exclu).
#
# Important : NE PAS réutiliser les secrets du développement local. Générer de
# nouvelles valeurs avec les commandes indiquées sous chaque clé sensible.

# Serveur
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://gestion.headquaters.org

# Base de données PostgreSQL — créer une base et un utilisateur dédiés sur le
# Postgres déjà installé sur le VPS (voir docs/DEPLOIEMENT.md, étape 4).
DATABASE_URL=postgresql://hq_gestion:CHANGER_MOI@localhost:5432/hq_gestion

# JWT — générer deux valeurs distinctes avec : openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGER_MOI
JWT_REFRESH_SECRET=CHANGER_MOI
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# Compte administrateur créé (ou mis à jour) par `npm run seed`. Changer le mot
# de passe ici avant le premier `npm run seed` en production.
SEED_ADMIN_EMAIL=admin@headquaters.org
SEED_ADMIN_PASSWORD=CHANGER_MOI
SEED_ADMIN_NAME=Administrateur HQ

# Envoi d'e-mails (mot de passe oublié + alertes critiques). Optionnel au
# lancement : si SMTP_HOST reste vide, ces e-mails sont journalisés côté
# serveur (visibles via `pm2 logs`) au lieu d'être envoyés — à compléter dès
# qu'un fournisseur SMTP est disponible.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HQ Gestion <no-reply@headquaters.org>

# Notifications push navigateur (Web Push). Générer une NOUVELLE paire pour la
# production (ne pas réutiliser celle du développement) :
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGER_MOI
VAPID_PRIVATE_KEY=CHANGER_MOI
VAPID_SUBJECT=mailto:contact@headquaters.org
