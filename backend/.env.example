# Serveur
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hq_gestion

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# Compte administrateur créé au seed
SEED_ADMIN_EMAIL=admin@hq.bf
SEED_ADMIN_PASSWORD=Admin@2026
SEED_ADMIN_NAME=Administrateur HQ

# Envoi d'e-mails (mot de passe oublié). Optionnel en développement : si
# SMTP_HOST est vide, le lien de réinitialisation est journalisé en console
# au lieu d'être envoyé par e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HQ Gestion <no-reply@headquaters.org>

# Notifications push navigateur (Web Push). Générer une paire de clés avec
# `npx web-push generate-vapid-keys`. Optionnel en développement : si absentes,
# l'envoi push est simplement ignoré (les notifications in-app restent actives).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@headquaters.org
